<?xml version="1.0" encoding="Shift_JIS"?>

<!DOCTYPE struts-config PUBLIC
	"-//Apache Software Foundation//DTD Struts Configuration 1.2//EN"
	"http://jakarta.apache.org/struts/dtds/struts-config_1_2.dtd">

<struts-config>
	
	<form-beans>
		<form-bean name="08KanjyoForm" type="app.system.form.KanjyoForm"></form-bean>
		<form-bean name="09KanjyoTorokuForm" type="app.system.form.KanjyoTorokuForm"></form-bean>
	</form-beans>


	<action-mappings>		
		<action
			path="/system/kanjyo"
			name="08KanjyoForm"
			type="app.system.action.KanjyoAction"
			scope="session">
			<forward name="OS7109" path="/system/kanjyo_mt.jsp"/>
		</action>
		
		<action
			path="/system/kanjyotoroku"
			name="09KanjyoTorokuForm"
			type="app.system.action.KanjyoTorokuAction"
			scope="session">
			<forward name="OS7109" path="/system/kanjyo_mt.jsp"/>
		</action>
	</action-mappings>
</struts-config>