			path="/common/tensou"
			name="05TensouForm"
			type="app.common.action.TensouAction"
			scope="session">
			<forward name="OZ3101" path="/common/tensou.jsp"/>
			<forward name="OB1102" path="/tairyu/toroku.jsp"/>
			<forward name="OC1102" path="/satei/toroku.jsp"/>
			<forward name="OC1103" path="/satei/kubun.jsp"/>
