			path="/common/tairyu_sincyoku"
			name="05tairyuSincyokuForm"
			type="app.common.action.TairyuSincyokuAction"
			scope="session">
			<forward name="OS6104" path="/syokai/sincyoku_syosai.jsp"/>
			<forward name="OS6105" path="/syokai/tokusokumail.jsp"/>
			<forward name="OZ4101" path="/common/sashimodoshiComment.jsp"/>
		</action>
		<action
			path="/common/kakunin"
			name="KakuninSyokaiForm"
			type="app.common.action.KakuninSyokaiAction"
			scope="session">
			<forward name="OZ6106" path="/common/kakunin.jsp"/>
		</action>

	</action-mappings>
</struts-config>
