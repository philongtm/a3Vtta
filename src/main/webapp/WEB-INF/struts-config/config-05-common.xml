			name="SaikenMeisaiSyokaiForm"
			type="app.common.action.SaikenMeisaiSyokaiAction"
			scope="session">
			<forward name="OC1107" path="/satei/syonin_syosai.jsp"/>
			<forward name="OS6102" path="/syokai/syosai.jsp"/>
			<forward name="OB2102" path="/tairyu/senteisyosai.jsp"/>
			<forward name="OZ1102" path="/common/tenpu_syokai.jsp"/>
			<forward name="OS3105" path="/system/kureemu_syoninsyosai.jsp"/>
		</action>
		<action
			path="/common/torihikisaki_gaiyo"
			name="TorihikisakiGaiyoSyokaiForm"
			type="app.common.action.TorihikisakiGaiyoSyokaiAction"
