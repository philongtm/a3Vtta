<?xml version="1.0" encoding="Shift_JIS"?>

<!DOCTYPE struts-config PUBLIC
	"-//Apache Software Foundation//DTD Struts Configuration 1.2//EN"
	"http://jakarta.apache.org/struts/dtds/struts-config_1_2.dtd">

<struts-config>
	
	<form-beans>
		<form-bean name="02SateikaisyaIchiranForm" type="app.system.form.SateikaisyaIchiranForm"></form-bean>
		<form-bean name="03SateikaisyaTorokuForm" type="app.system.form.SateikaisyaTorokuForm"></form-bean>
	</form-beans>

	<action-mappings>		
		<action
			path="/system/sateikaisyaichiran"
			name="02SateikaisyaIchiranForm"
			type="app.system.action.SateikaisyaIchiranAction"
			scope="session">
			
			<forward name="OS7103" path="/system/sateikaisya_mt.jsp"/>
		</action>
		
		<action
			path="/system/sateikaisyatoroku"
			name="03SateikaisyaTorokuForm"
			type="app.system.action.SateikaisyaTorokuAction"
			scope="session">
			
			<forward name="OS7103" path="/system/sateikaisya_mt.jsp"/>
		</action>
	</action-mappings>
</struts-config>