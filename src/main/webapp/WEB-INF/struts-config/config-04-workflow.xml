<?xml version="1.0" encoding="Shift_JIS"?>

<!DOCTYPE struts-config PUBLIC
	"-//Apache Software Foundation//DTD Struts Configuration 1.2//EN"
	"http://jakarta.apache.org/struts/dtds/struts-config_1_2.dtd">

<struts-config>
	
	<form-beans>
		<form-bean name="04WorkFlowIchiranForm" type="app.system.form.WorkFlowIchiranForm"></form-bean>
		<form-bean name="05WorkFlowTorokuForm" type="app.system.form.WorkFlowTorokuForm"></form-bean>
	</form-beans>
	
	<action-mappings>	
		<action
			path="/system/workflowichiran"
			name="04WorkFlowIchiranForm"
			type="app.system.action.WorkFlowIchiranAction"
			scope="session">
			<forward name="OS7105" path="/system/workflow_mt.jsp"/>
		</action>
		<action
			path="/system/workflowtoroku"
			name="05WorkFlowTorokuForm"
			type="app.system.action.WorkFlowTorokuAction"
			scope="session">
			<forward name="OS7105" path="/system/workflow_mt.jsp"/>
		</action>
	</action-mappings>
</struts-config>